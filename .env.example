APP_PORT=8001
SERVICE_NAME=go-crud

GIN_MODE=release

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=learning_go
# DB_SSLMODE: disable (dev), require (prod minimum), verify-full (prod recommended)
DB_SSLMODE=disable
DB_TIMEZONE=UTC

DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=5
DB_CONN_MAX_IDLE_TIME=1

# Prep User Service (API Gateway). Empty = use stub adapter for development.
PREP_USER_SERVICE_URL=

MIGRATION_PATH=migrations

CB_MAX_REQUESTS=5
CB_INTERVAL=60
CB_TIMEOUT=30
CB_FAILURE_RATIO=0.6
CB_MIN_REQUESTS=10

LOG_LEVEL=info
LOG_FORMAT=json
# LOG_CHANNELS: comma-separated list of channels. Available: console, daily, otlp
# Examples: console | console,daily | console,daily,otlp
LOG_CHANNELS=console

# Daily file rotation (used when LOG_CHANNELS includes "daily")
LOG_FILE_PATH=logs/app.log
LOG_MAX_SIZE=100
LOG_MAX_BACKUPS=7
LOG_MAX_AGE=30
LOG_COMPRESS=false

# OpenTelemetry OTLP exporter (for tracing and remote logging)
OTLP_ENDPOINT=
OTLP_INSECURE=true

# Sentry error tracking
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_SAMPLE_RATE=1.0

# OCR Service (Python PaddleOCR wrapper). See scripts/ocr-service/README.md
OCR_SERVICE_URL=http://localhost:8000

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
